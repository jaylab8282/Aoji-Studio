# docker compose up -d 실행 전 이 파일을 .env로 복사하고 값을 채운다.
# 여기 있는 값만 compose가 컨테이너로 넘긴다. .env는 커밋하지 않는다.

# ── 필수 ────────────────────────────────────────────────────────────────────

# JayStudio 폴더의 절대 경로. 비어 있으면 compose가 기동을 거부한다.
#   macOS   /Users/<사용자>/Desktop/JayStudio
#   Windows C:\Users\<사용자>\Desktop\JayStudio
JAYSTUDIO_HOST_PATH=

# 웹을 공개할 호스트 포트. 127.0.0.1에만 바인딩한다.
# 컨테이너에는 JAYSTUDIO_PUBLIC_PORT로 전달되고, 허용 Origin도 이 값에서 자동 계산된다.
JAYSTUDIO_PORT=4180

# ── 선택 (주석을 풀면 적용된다) ─────────────────────────────────────────────

# 이미지 아키텍처. 기본은 Apple Silicon 기준 linux/arm64다.
# 윈도우·리눅스 등 x86_64 머신에서는 아래 줄의 주석을 푼다.
#JAYSTUDIO_PLATFORM=linux/amd64

# 브라우저가 호출할 열기 도우미 주소. 기본 4181이 아닌 포트로 설치했을 때만 바꾼다
# (helper/install.sh --port <번호>). 열기 도우미는 macOS 전용이다.
#JAYSTUDIO_HELPER_URL=http://127.0.0.1:4181

# ── 참고: compose가 고정으로 넘기므로 .env로 바꾸지 않는다 ──────────────────

# JAYSTUDIO_MOUNT_PATH=/workspace
#   컨테이너 안에서 JayStudio 폴더가 보이는 경로.
#
# JAYSTUDIO_DATA_PATH=/data
#   이벤트 SQLite 위치. named volume(jaystudio-data)에 보관한다.
#
# JAYSTUDIO_ALLOWED_ORIGINS
#   허용 Origin. JAYSTUDIO_PORT에서 자동 계산되므로 직접 설정하지 않는다.
#   넓히면 다른 로컬 웹페이지가 이 앱을 조작할 수 있게 되어 보안 전제가 깨진다.
#
# SPRING_PROFILES_ACTIVE
#   컨테이너에서는 설정하지 않는다. dev를 켜면 허용 Origin이 5173 하나로 바뀌어
#   앱 전체가 403이 된다(fail-closed, ADR-47).
