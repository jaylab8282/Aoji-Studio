# 환경 변수·토큰 (conventions.md §1)
.env
*-token

# Backend (Gradle)
backend/build/
backend/.gradle/
backend/src/main/resources/static/

# Frontend (Vite)
**/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Helper
helper/node_modules/

# Tools / E2E
tools/e2e/test-results/
tools/e2e/playwright-report/
tools/e2e/node_modules/
tools/e2e/.e2e-state.json
tools/e2e/.helper-dry-run.log
tools/e2e/.other-origin-server.log
!tools/e2e/screenshots/*.png
tools/replay/node_modules/

# SQLite
*.db
*.db-wal
*.db-shm
*.db.corrupt-*

# OS / IDE
.DS_Store
.idea/
.vscode/
*.iml

# 설계·진행 문서 (사용자 결정 2026-10-01 — 저장소에 올리지 않는다)
# 파일은 로컬에 그대로 둔다. 요구사항·설계·태스크·결정 이력·리뷰 38건이 여기 있고
# develop-tech-lead는 docs/progress.md·docs/tasks.md로 작업을 재개한다.
# 주의: tools/e2e/tests/e2e-13.spec.ts가 docs/ui/screens/*.png을 기준 이미지로 읽는다
#       → 이 폴더가 없는 곳에서 클론하면 E2E 배치 8(7개)이 실패한다(107 → 100).
docs/
